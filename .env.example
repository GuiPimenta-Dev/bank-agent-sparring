# Copy to .env and run commands with `uv run --env-file .env ...`.
ANTHROPIC_API_KEY=

# Optional: defaults to claude-haiku-5-5 and the model's default effort.
SPARRING_AGENT_MODEL=claude-haiku-5-5
SPARRING_AGENT_EFFORT=

# The Simulated User and judges (ADR-0013). The model is pinned: pick it once from the
# OpenAI models API and never change it without a rebaseline (ADR-0006).
OPENAI_API_KEY=
SPARRING_SIMULATOR_MODEL=

# Local Langfuse (infra/langfuse); leave LANGFUSE_PUBLIC_KEY empty to disable tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_BASE_URL=http://localhost:3000
