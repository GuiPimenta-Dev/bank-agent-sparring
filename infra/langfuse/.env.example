# Local-only Langfuse settings, read by docker compose from infra/langfuse/.env.
# Copy this file to .env; nothing here is a real secret.
LANGFUSE_INIT_ORG_ID=sparring
LANGFUSE_INIT_ORG_NAME=Sparring
LANGFUSE_INIT_PROJECT_ID=sparring
LANGFUSE_INIT_PROJECT_NAME=sparring
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev
LANGFUSE_INIT_USER_EMAIL=dev@sparring.local
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=sparring-local-dev
